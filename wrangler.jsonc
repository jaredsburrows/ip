{
  // Static assets are served straight from the edge and are not billed as
  // Worker invocations. Only the API paths listed in run_worker_first run the
  // Worker script, so scanner probes of other /api/* paths cost nothing and
  // get the static 404 page; if the free-tier daily limit is ever hit, the API
  // returns 429 while the static page keeps serving.
  "name": "ip",
  "account_id": "23fd1f78e6c723b48b52bd073092907a",
  "main": "worker.js",
  "compatibility_date": "2026-07-23",
  // Live-globe presence. One global instance holds the presence map in memory
  // only (see globe.js): the class is SQLite-backed because the free plan
  // requires it, but nothing is ever written to storage.
  "durable_objects": {
    "bindings": [
      { "name": "GLOBE", "class_name": "GlobePresence" }
    ]
  },
  // ROLLBACK RECIPE — read this before reverting anything in this file.
  // A deployed migration is append-only: it must stay here, with its tag, for
  // as long as the class exists. Deleting or renumbering this entry (which is
  // what a plain `git revert` of the commit that added it does) makes
  // `wrangler deploy` fail outright, which blocks EVERY deploy from this repo
  // — including unrelated fixes to /api/info — and dashboard rollback cannot
  // cross a lifecycle change either.
  // To retire the globe, in ONE commit: remove the GLOBE binding above, remove
  // the GlobePresence export from worker.js, and APPEND
  //   { "tag": "globe-presence-v2", "deleted_classes": ["GlobePresence"] }
  // to the end of this array. Never remove globe-presence-v1.
  "migrations": [
    { "tag": "globe-presence-v1", "new_sqlite_classes": ["GlobePresence"] }
  ],
  "ratelimits": [
    {
      "name": "LOCATION_LIMITER",
      "namespace_id": "2026091301",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Coarse ceiling shared by every caller at a Cloudflare location; the
      // per-client bucket above is checked first. See location.js.
      "name": "LOCATION_LIMITER_COARSE",
      "namespace_id": "2026091401",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      // Belt-and-braces on the public globe write path only. The design does
      // not depend on it; the real bounds are the server-derived coordinates
      // and the caps in globe.js.
      "name": "GLOBE_LIMITER",
      "namespace_id": "2026091402",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    // Every Worker-served path must appear here or it is served as a static
    // asset and never reaches the Worker.
    "run_worker_first": ["/api/info", "/api/location", "/api/globe/positions", "/api/globe/presence"]
  }
}
