{
  // Static assets are served straight from the edge and are not billed as
  // Worker invocations. Only /api/* runs the Worker script (run_worker_first);
  // if the free-tier daily limit is ever hit, /api/* returns 429 while the
  // static page keeps serving.
  "name": "ip",
  "account_id": "23fd1f78e6c723b48b52bd073092907a",
  "main": "worker.js",
  "compatibility_date": "2026-07-23",
  "ratelimits": [
    {
      "name": "LOCATION_LIMITER",
      "namespace_id": "2026091301",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
